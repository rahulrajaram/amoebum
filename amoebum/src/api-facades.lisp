(in-package :amoebum.internal)

;;; I370: explicit wrapped facade packages for UI, slash-command models, and
;;; worker-facing runtime surfaces. These stay available, but no longer bloat
;;; the root :amoebum package.

(defparameter +amoebum-raw-api-packages+
  '(:amoebum.sandbox)
  "Packages intentionally left raw/powerful at the public surface.")

(defparameter +amoebum-wrapped-api-packages+
  '(:amoebum.ui :amoebum.commands :amoebum.workers :amoebum.config :amoebum.notifications
    :amoebum.sessions :amoebum.plan :amoebum.extensions :amoebum.observability :amoebum.tools :amoebum.safety)
  "Facade packages that now own domain-specific wrapped APIs.")

