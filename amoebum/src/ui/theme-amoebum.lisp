(in-package :amoebum)

;;; ---------------------------------------------------------------------------
;;; Amoebum Dark Theme — Tokyo Night inspired palette
;;; ---------------------------------------------------------------------------

(ptui.core.theme:define-theme amoebum-dark
  (:base :dark)
  (:background (rgb 16 18 24))
  (:foreground (rgb 220 226 236))
  (:roles
    (:user-label      :fg (rgb 224 175 104) :boldp t)
    (:assistant-label :fg (rgb 122 162 247) :boldp t)
    (:assistant       :fg (rgb 220 226 236))
    (:user            :fg (rgb 220 226 236))
    (:tool-label      :fg (rgb 125 207 255) :boldp t)
    (:tool            :fg (rgb 125 207 255))
    (:system          :fg (rgb 160 170 186))
    (:warning         :fg (rgb 240 198 116) :boldp t)
    (:error           :fg (rgb 242 143 173) :boldp t)
    (:meta            :fg (rgb 116 124 138))
    (:status-bar      :fg (rgb 160 170 186) :bg (rgb 30 36 46))
    (:context-green   :fg (rgb 158 206 106) :bg (rgb 30 36 46) :boldp t)
    (:context-yellow  :fg (rgb 240 198 116) :bg (rgb 30 36 46) :boldp t)
    (:context-red     :fg (rgb 242 143 173) :bg (rgb 30 36 46) :boldp t)
    (:prompt          :fg (rgb 220 226 236))
    (:prompt-border   :fg (rgb 109 140 189))
    (:assistant-heading    :fg (rgb 122 162 247) :boldp t)
    (:assistant-code       :fg (rgb 220 226 236) :bg (rgb 36 42 54))
    (:assistant-code-keyword :fg (rgb 242 143 173) :boldp t :bg (rgb 36 42 54))
    (:assistant-code-fence :fg (rgb 58 70 86) :dimp t :bg (rgb 36 42 54))
    (:assistant-code-string :fg (rgb 158 206 106) :bg (rgb 36 42 54))
    (:assistant-code-function :fg (rgb 122 162 247) :bg (rgb 36 42 54))
    (:assistant-code-comment :fg (rgb 116 124 138) :bg (rgb 36 42 54) :italicp t)
    (:assistant-code-number :fg (rgb 240 198 116) :bg (rgb 36 42 54))
    (:assistant-inline-code :fg (rgb 220 226 236) :bg (rgb 36 42 54))
    (:approval-label :fg (rgb 116 124 138))
    (:approval-command :fg (rgb 125 207 255))
    (:approval-path :fg (rgb 158 206 106))
    (:tool-preview-keyword :fg (rgb 116 124 138))
    (:tool-preview-tool :fg (rgb 122 162 247) :boldp t)
    (:tool-preview-status-streaming :fg (rgb 116 124 138) :dimp t)
    (:tool-preview-status-running :fg (rgb 240 198 116))
    (:tool-preview-status-error :fg (rgb 242 143 173) :boldp t)
    (:tool-preview-args-label :fg (rgb 116 124 138))
    (:tool-preview-args :fg (rgb 220 226 236))
    (:tool-preview-error :fg (rgb 242 143 173))
    (:tool-preview-error-text :fg (rgb 242 143 173) :boldp t)
    (:tool-preview-spinner :fg (rgb 122 162 247))
    (:tree-row-indent :fg (rgb 64 72 86))
    (:tree-glyph-open :fg (rgb 116 124 138))
    (:tree-glyph-expanded :fg (rgb 158 206 106) :boldp t)
    (:tree-glyph-collapsed :fg (rgb 240 198 116) :boldp t)
    (:tree-status-empty :fg (rgb 58 70 86))
    (:tree-directory-name :fg (rgb 122 162 247) :boldp t)
    (:tree-file-name :fg (rgb 220 226 236)))
  (:markdown
    (:code-background       (rgb 36 42 54))
    (:code-foreground       (rgb 220 226 236))
    (:fence-color           (rgb 58 70 86))
    (:keyword-color         (rgb 242 143 173))
    (:heading-color         (rgb 122 162 247))
    (:inline-code-background (rgb 36 42 54))
    (:inline-code-foreground (rgb 220 226 236))))

;;; Set as active theme
(setf ptui.core.theme:*active-theme*
      (ptui.core.theme:find-theme 'amoebum-dark))
