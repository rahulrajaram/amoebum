#!/usr/bin/env bpftrace
/*
 * I361: Trace streaming request throughput and duration using amoebum probes.
 *
 * Usage examples:
 *   sudo bpftrace scripts/trace/stream-throughput.bt -p <amoebum-pid>
 *   sudo bpftrace scripts/trace/stream-throughput.bt -c ./dist/amoebum
 *
 * Referenced probes (implemented in amoebum/src/usdt.lisp):
 *   amoebum:llm-request-start(model, base_url, mode, request_id)
 *   amoebum:llm-request-end(model, base_url, mode, request_id, elapsed_ms, status)
 */

BEGIN
{
  printf("Tracing amoebum stream throughput (probes: llm-request-start/end). Hit Ctrl-C to stop.\n");
}

usdt:*:amoebum:llm-request-start
{
  $request_id = str(arg3);
  @request_start_ns[$request_id] = nsecs;
  @active_streams = @active_streams + 1;
}

usdt:*:amoebum:llm-request-end
{
  $model = str(arg0);
  $request_id = str(arg3);
  $elapsed_ms = (uint64)arg4;

  if ($elapsed_ms == 0 && @request_start_ns[$request_id] > 0) {
    $elapsed_ms = (nsecs - @request_start_ns[$request_id]) / 1000000;
  }

  if (@active_streams > 0) {
    @active_streams = @active_streams - 1;
  }

  @stream_completions_total[$model] = count();
  @stream_latency_ms[$model] = hist($elapsed_ms);

  /*
   * Per-second snapshot maps are cleared every interval for simple throughput
   * visibility (completed streams/sec by model).
   */
  @stream_completions_1s[$model] = count();
  @stream_latency_sum_1s_ms[$model] = sum($elapsed_ms);

  delete(@request_start_ns[$request_id]);
}

interval:s:1
{
  printf("\n=== stream throughput (1s window) ===\n");
  print(@stream_completions_1s);
  print(@stream_latency_sum_1s_ms);
  printf("active_streams=%d\n", @active_streams);
  clear(@stream_completions_1s);
  clear(@stream_latency_sum_1s_ms);
}

END
{
  printf("\n=== total stream completions by model ===\n");
  print(@stream_completions_total);
  printf("\n=== stream latency histograms (ms) ===\n");
  print(@stream_latency_ms);
}
