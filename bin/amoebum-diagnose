#!/bin/bash
# Amoebum Diagnostic Helper
# Provides diagnostic commands for common failure modes
# Addresses: Retry-Without-Diagnosis issue

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

show_help() {
    cat << EOF
Amoebum Diagnostic Helper - Diagnose common issues before retrying

USAGE:
    amoebum-diagnose [COMMAND] [OPTIONS]

COMMANDS:
    build           Diagnose build failures
    syntax          Diagnose syntax errors
    runtime         Diagnose runtime errors (undefined functions, etc.)
    theme           Diagnose YAML theme loading issues
    all             Run all diagnostics

OPTIONS:
    -h, --help      Show this help message
    -v, --verbose   Verbose output

EXAMPLES:
    amoebum-diagnose build          # Check build issues
    amoebum-diagnose syntax         # Check for syntax errors
    amoebum-diagnose runtime        # Check runtime configuration
    amoebum-diagnose all            # Full diagnostic suite

EOF
}

log_info() {
    echo -e "${BLUE}[DIAG]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[FAIL]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

# Diagnostic for build failures
diagnose_build() {
    echo ""
    echo "========================================"
    echo "BUILD FAILURE DIAGNOSTIC"
    echo "========================================"
    
    log_info "Checking for syntax errors in Lisp files..."
    
    local syntax_errors=0
    while IFS= read -r file; do
        local open_parens=$(grep -o '(' "$file" | wc -l)
        local close_parens=$(grep -o ')' "$file" | wc -l)
        
        if [[ $open_parens -ne $close_parens ]]; then
            log_error "Unbalanced parens: $file ($open_parens open, $close_parens close)"
            ((syntax_errors++))
            
            # Show problematic lines
            echo "  Potentially affected definitions:"
            grep -n "^\\s*(defun\\|^\\s*(defmacro\\|^\\s*(defmethod\\|^\\s*(defclass" "$file" 2>/dev/null | head -5 | sed 's/^/    /'
        fi
    done < <(find "$PROJECT_ROOT" -name "*.lisp" -type f 2>/dev/null)
    
    if [[ $syntax_errors -eq 0 ]]; then
        log_success "No syntax errors detected"
    else
        log_error "Found $syntax_errors file(s) with syntax errors"
        echo ""
        echo "Next steps:"
        echo "  1. Run: amoebum-lint <file> for detailed analysis"
        echo "  2. Fix unbalanced parentheses in identified files"
        echo "  3. Re-run build"
    fi
    
    echo ""
    log_info "Checking for missing dependencies..."
    
    # Check for Quicklisp
    if command -v sbcl &> /dev/null; then
        if sbcl --noinform --non-interactive --eval "(require 'asdf)" --eval "(require 'ql)" --eval "(sb-ext:exit)" 2>/dev/null; then
            log_success "Quicklisp available"
        else
            log_warn "Quicklisp may not be configured"
            echo "  Run: (ql:add-to-init-file) in SBCL"
        fi
    else
        log_error "SBCL not found in PATH"
    fi
    
    return $syntax_errors
}

# Diagnostic for runtime errors
diagnose_runtime() {
    echo ""
    echo "========================================"
    echo "RUNTIME ERROR DIAGNOSTIC"
    echo "========================================"
    
    log_info "Checking for undefined functions..."
    
    # List all defun/defmacro definitions
    local defined_functions=$(mktemp)
    local called_functions=$(mktemp)
    
    grep -rh "^\\s*(defun\\s\\+\\([^ )]*" "$PROJECT_ROOT" --include="*.lisp" 2>/dev/null | \
        sed 's/.*defun\s\+\([^ )]*\).*/\1/' | sort -u > "$defined_functions"
    
    log_info "Found $(wc -l < "$defined_functions") function definitions"
    
    # Check for common undefined function patterns in error logs
    if [[ -f "$PROJECT_ROOT/build.log" ]]; then
        log_info "Checking build.log for undefined function errors..."
        grep -i "undefined" "$PROJECT_ROOT/build.log" | head -10
    fi
    
    rm -f "$defined_functions" "$called_functions"
    
    echo ""
    log_info "Checking binary integrity..."
    if [[ -f "$PROJECT_ROOT/amoebum" ]]; then
        log_success "Binary exists"
        
        # Check if binary is executable
        if [[ -x "$PROJECT_ROOT/amoebum" ]]; then
            log_success "Binary is executable"
        else
            log_warn "Binary not executable - run: chmod +x amoebum"
        fi
        
        # Check file size (should be substantial)
        local size=$(stat -f%z "$PROJECT_ROOT/amoebum" 2>/dev/null || stat -c%s "$PROJECT_ROOT/amoebum" 2>/dev/null || echo "0")
        if [[ $size -lt 1000000 ]]; then
            log_warn "Binary seems small ($size bytes) - may be incomplete"
        fi
    else
        log_error "Binary not found at $PROJECT_ROOT/amoebum"
    fi
}

# Diagnostic for syntax errors
diagnose_syntax() {
    echo ""
    echo "========================================"
    echo "SYNTAX ERROR DIAGNOSTIC"
    echo "========================================"
    
    log_info "Running full syntax check on all Lisp files..."
    
    bash "$SCRIPT_DIR/amoebum-lint" --all 2>&1 || true
}

# Diagnostic for theme loading issues
diagnose_theme() {
    echo ""
    echo "========================================"
    echo "THEME LOADING DIAGNOSTIC"
    echo "========================================"
    
    log_info "Checking yaml-theme-loader.lisp..."
    local loader="$PROJECT_ROOT/src/yaml-theme-loader.lisp"
    
    if [[ ! -f "$loader" ]]; then
        log_error "Theme loader not found: $loader"
        return 1
    fi
    
    # Check for load-yaml-theme function
    if grep -q "(defun.*load-yaml-theme" "$loader"; then
        log_success "load-yaml-theme function found"
    else
        log_error "load-yaml-theme function not found!"
        echo "  This is likely the cause of 'undefined function' errors"
    fi
    
    # Check for common YAML loader issues
    log_info "Checking for YAML library availability..."
    
    if sbcl --noinform --non-interactive --eval "(ql:quickload :cl-yaml)" --eval "(sb-ext:exit)" 2>/dev/null; then
        log_success "cl-yaml library available"
    else
        log_warn "cl-yaml library may not be installed"
        echo "  Run: (ql:quickload :cl-yaml) in SBCL"
    fi
    
    # Check theme directory
    if [[ -d "$PROJECT_ROOT/themes" ]]; then
        log_success "Themes directory exists"
        local theme_count=$(find "$PROJECT_ROOT/themes" -name "*.yaml" | wc -l)
        log_info "Found $theme_count YAML theme files"
    else
        log_warn "Themes directory not found at $PROJECT_ROOT/themes"
    fi
}

# Run all diagnostics
diagnose_all() {
    diagnose_build
    diagnose_syntax
    diagnose_runtime
    diagnose_theme
    
    echo ""
    echo "========================================"
    echo "DIAGNOSTIC COMPLETE"
    echo "========================================"
    echo ""
    echo "Next steps based on findings:"
    echo "  - If syntax errors found: Fix unbalanced parentheses"
    echo "  - If undefined functions: Check file was compiled properly"
    echo "  - If missing dependencies: Install with Quicklisp"
    echo "  - If theme issues: Verify yaml-theme-loader.lisp syntax"
}

# Main execution
main() {
    local command="${1:-all}"
    local verbose=false
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                verbose=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                shift
                ;;
        esac
    done
    
    case $command in
        build)
            diagnose_build
            ;;
        syntax)
            diagnose_syntax
            ;;
        runtime)
            diagnose_runtime
            ;;
        theme)
            diagnose_theme
            ;;
        all)
            diagnose_all
            ;;
        *)
            log_error "Unknown command: $command"
            show_help
            exit 1
            ;;
    esac
}

main "$@"
