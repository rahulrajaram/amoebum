#!/bin/bash
# Amoebum Self-Check - Validate amoebum's own source integrity
# This runs BEFORE loading amoebum to catch syntax errors early

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

log_info() {
    echo -e "${BLUE}[CHECK]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
    ((WARNINGS++))
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
    ((ERRORS++))
}

log_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

show_help() {
    printf '%s\n' \
        'Amoebum Self-Check - Validate source integrity before loading' \
        '' \
        'USAGE:' \
        '    amoebum-self-check [OPTIONS]' \
        '' \
        'OPTIONS:' \
        '    -h, --help          Show this help message' \
        '    -v, --verbose       Verbose output' \
        '    --strict            Fail on warnings too' \
        '    --fix               Attempt auto-fix where possible' \
        '' \
        'DESCRIPTION:' \
        '    This tool validates amoebum'\''s Lisp source files for:' \
        '    - Parser-aware parenthesis balance (ignores strings/comments)' \
        '    - Missing critical function definitions' \
        '    - Repo prerequisites needed by the local Yarli wrapper' \
        '' \
        '    It also checks the repo wrapper prerequisites that must exist' \
        '    before the local Yarli entrypoint can run safely.' \
        '' \
        'EXAMPLES:' \
        '    amoebum-self-check              # Quick validation' \
        '    amoebum-self-check -v           # Detailed output' \
        '    amoebum-self-check --strict     # Fail on any issue' \
        ''
}

check_lisp_structure() {
    local verbose="$1"
    shift
    local files=("$@")
    local report

    if ! command -v sbcl >/dev/null 2>&1; then
        log_error "sbcl command NOT FOUND on PATH"
        return 1
    fi

    report="$(mktemp)"
    if sbcl --script "$PROJECT_ROOT/bin/lisp-paren-check.lisp" "${files[@]}" >"$report" 2>&1; then
        log_success "Parser-aware structural scan OK (${#files[@]} files)"
        if [[ "$verbose" == "true" ]]; then
            sed 's/^/  /' "$report"
        fi
        rm -f "$report"
        return 0
    fi

    log_error "Parser-aware structural scan found issues"
    sed 's/^/  /' "$report"
    rm -f "$report"
    return 1
}

check_critical_functions() {
    log_info "Checking critical function definitions..."
    
    local yaml_loader="$PROJECT_ROOT/amoebum/src/ui/yaml-theme-loader.lisp"
    
    if [[ ! -f "$yaml_loader" ]]; then
        log_error "yaml-theme-loader.lisp not found"
        return 1
    fi
    
    if grep -q "(defun load-yaml-theme" "$yaml_loader"; then
        log_success "load-yaml-theme function found"
    else
        log_error "load-yaml-theme function NOT FOUND in yaml-theme-loader.lisp"
        echo "  This would cause runtime 'undefined function' errors"
        return 1
    fi
}

check_repo_runtime_prereqs() {
    log_info "Checking repo runtime prerequisites..."

    if command -v yarli >/dev/null 2>&1; then
        log_success "yarli command found"
    else
        log_error "yarli command NOT FOUND on PATH"
    fi

    if [[ -f "$PROJECT_ROOT/yarli.toml" ]]; then
        log_success "yarli.toml found"
    else
        log_error "yarli.toml not found"
    fi

    if [[ -f "$PROJECT_ROOT/bin/yarli-bootstrap-local-state.sh" ]]; then
        log_success "bin/yarli-bootstrap-local-state.sh found"
    else
        log_error "bin/yarli-bootstrap-local-state.sh not found"
    fi
}

main() {
    local verbose=false
    local strict=false
    local fix=false
    
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -v|--verbose)
                verbose=true
                shift
                ;;
            --strict)
                strict=true
                shift
                ;;
            --fix)
                fix=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
        esac
    done
    
    echo "========================================"
    echo "Amoebum Self-Check"
    echo "========================================"
    echo ""
    
    # Find all Lisp source files
    local src_dir="$PROJECT_ROOT/amoebum/src"
    
    if [[ ! -d "$src_dir" ]]; then
        log_error "Source directory not found: $src_dir"
        exit 1
    fi
    
    log_info "Scanning source files..."
    
    local files=()
    while IFS= read -r -d '' file; do
        files+=("$file")
    done < <(find "$src_dir" -name "*.lisp" -type f -print0 2>/dev/null)
    
    log_info "Found ${#files[@]} Lisp files"
    echo ""
    
    check_lisp_structure "$verbose" "${files[@]}" || true
    
    echo ""
    check_critical_functions || true
    echo ""
    check_repo_runtime_prereqs || true

    # Summary
    echo ""
    echo "========================================"
    echo "Summary"
    echo "========================================"
    
    if [[ $ERRORS -eq 0 && ! ( "$strict" == "true" && $WARNINGS -gt 0 ) ]]; then
        echo -e "${GREEN}✓ All checks passed${NC}"
        echo "  Files checked: ${#files[@]}"
        echo "  Errors: 0"
        echo "  Warnings: $WARNINGS"
        echo ""
        echo "Amoebum source validation OK - safe to compile/load"
        exit 0
    else
        echo -e "${RED}✗ Validation failed${NC}"
        echo "  Files checked: ${#files[@]}"
        echo "  Errors: $ERRORS"
        echo "  Warnings: $WARNINGS"
        echo ""
        if [[ "$strict" == "true" && $WARNINGS -gt 0 && $ERRORS -eq 0 ]]; then
            echo "Strict mode treats warnings as failures."
        else
            echo "Fix errors before compiling or loading amoebum."
        fi
        echo "Run 'sbcl --script bin/lisp-paren-check.lisp --project' for structural details."
        exit 1
    fi
}

main "$@"
