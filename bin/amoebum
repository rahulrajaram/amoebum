#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

usage() {
  printf '%s\n' \
    'Usage:' \
    '  bin/amoebum' \
    '' \
    'Behavior:' \
    '  1) bootstrap local yarli state' \
    '  2) sanitize continuation state' \
    '  3) run `yarli run --stream`' \
    '' \
    'No subcommands or arguments are supported.'
}

fail() {
  echo "AMOEBUM_ERROR: $*" >&2
  exit 1
}

require_cmd() {
  local cmd="$1"
  command -v "${cmd}" >/dev/null 2>&1 || fail "missing required command: ${cmd}"
}

require_file() {
  local path="$1"
  [[ -f "${path}" ]] || fail "missing required file: ${path}"
}

bootstrap_local_state() {
  require_file "${REPO_ROOT}/bin/yarli-bootstrap-local-state.sh"
  (
    cd "${REPO_ROOT}"
    "${REPO_ROOT}/bin/yarli-bootstrap-local-state.sh"
  )
}

main() {
  if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    bootstrap_local_state >/dev/null
    usage
    exit 0
  fi

  if [[ $# -ne 0 ]]; then
    fail "no arguments supported (use: bin/amoebum)"
  fi

  require_cmd yarli
  require_file "${REPO_ROOT}/bin/yarli-sanitize-continuation.sh"

  bootstrap_local_state

  (
    cd "${REPO_ROOT}"
    "${REPO_ROOT}/bin/yarli-sanitize-continuation.sh"
  )

  (
    cd "${REPO_ROOT}"
    exec yarli run --stream
  )
}

main "$@"
