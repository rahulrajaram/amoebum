#!/bin/bash
# Amoebum Unified Lint Tool
# Consolidates syntax checking, compilation verification, and style checks
# Addresses: Retry-Without-Diagnosis and Tool Discovery Gap issues

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Counters
CHECKS_PASSED=0
CHECKS_FAILED=0
WARNINGS=0

show_help() {
    cat << EOF
Amoebum Lint Tool - Unified syntax and build verification

USAGE:
    amoebum-lint [OPTIONS] [FILES...]

OPTIONS:
    -h, --help          Show this help message
    -a, --all           Check all Lisp files in project
    -s, --syntax        Syntax check only (paren/bracket/quote balance)
    -c, --compile       Compilation check only
    -v, --verbose       Verbose output
    --fix               Attempt to auto-fix issues (where possible)

EXAMPLES:
    amoebum-lint                    # Check all files
    amoebum-lint src/file.lisp      # Check specific file
    amoebum-lint -s src/file.lisp   # Syntax check only
    amoebum-lint -a -v              # Verbose check of all files

EOF
}

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
    ((WARNINGS++))
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
    ((CHECKS_FAILED++))
}

log_success() {
    echo -e "${GREEN}[PASS]${NC} $1"
    ((CHECKS_PASSED++))
}

# Check if a command exists
check_command() {
    if ! command -v "$1" &> /dev/null; then
        log_error "Required command not found: $1"
        return 1
    fi
    return 0
}

# Syntax check: paren/bracket/brace/quote balance
check_syntax() {
    local file="$1"
    local verbose="$2"
    
    if [[ "$verbose" == "true" ]]; then
        log_info "Checking syntax: $file"
    fi
    
    if [[ ! -f "$file" ]]; then
        log_error "File not found: $file"
        return 1
    fi
    
    # Count parentheses
    local open_parens=$(grep -o '(' "$file" | wc -l)
    local close_parens=$(grep -o ')' "$file" | wc -l)
    
    if [[ $open_parens -ne $close_parens ]]; then
        log_error "Unbalanced parentheses in $file: $open_parens open, $close_parens close"
        
        # Diagnostic: find problematic lines
        echo "  Diagnostic: Finding lines with potential issues..."
        grep -n "defun\|defmacro\|defmethod\|defclass" "$file" | head -10 | while read line; do
            echo "    $line"
        done
        return 1
    fi
    
    # Count brackets
    local open_brackets=$(grep -o '\[' "$file" | wc -l)
    local close_brackets=$(grep -o '\]' "$file" | wc -l)
    
    if [[ $open_brackets -ne $close_brackets ]]; then
        log_error "Unbalanced brackets in $file: $open_brackets open, $close_brackets close"
        return 1
    fi
    
    # Count braces  
    local open_braces=$(grep -o '{' "$file" | wc -l)
    local close_braces=$(grep -o '}' "$file" | wc -l)
    
    if [[ $open_braces -ne $close_braces ]]; then
        log_error "Unbalanced braces in $file: $open_braces open, $close_braces close"
        return 1
    fi
    
    # Check for common syntax errors
    if grep -n '"[^"]*$' "$file" > /dev/null 2>&1; then
        log_error "Unclosed string detected in $file"
        grep -n '"[^"]*$' "$file" | head -5 | sed 's/^/  /'
        return 1
    fi
    
    log_success "Syntax OK: $file"
    return 0
}

# Compilation check
compile_check() {
    local file="$1"
    local verbose="$2"
    
    if [[ "$verbose" == "true" ]]; then
        log_info "Checking compilation: $file"
    fi
    
    # Extract package name from file (simplified)
    local pkg=$(grep -oP '\(in-package\s+:\K[^)]+' "$file" | head -1)
    
    # Try to compile with sbcl
    local temp_log=$(mktemp)
    if ! sbcl --noinform --non-interactive \
              --eval "(require 'asdf)" \
              --eval "(handler-case (load \"$file\") (error (e) (format t \"COMPILATION-ERROR: ~A~%\" e) (sb-ext:exit :code 1)))" \
              --eval "(sb-ext:exit :code 0)" 2>&1 | tee "$temp_log"; then
        log_error "Compilation failed for $file"
        if [[ -s "$temp_log" ]]; then
            echo "  Output:"
            grep -i "error\|warning" "$temp_log" | head -5 | sed 's/^/    /'
        fi
        rm -f "$temp_log"
        return 1
    fi
    
    rm -f "$temp_log"
    log_success "Compilation OK: $file"
    return 0
}

# Find all Lisp files
find_lisp_files() {
    find "$PROJECT_ROOT" -name "*.lisp" -type f | grep -v ".git" | sort
}

# Main execution
main() {
    local check_all=false
    local syntax_only=false
    local compile_only=false
    local verbose=false
    local fix_mode=false
    local files=()
    
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                exit 0
                ;;
            -a|--all)
                check_all=true
                shift
                ;;
            -s|--syntax)
                syntax_only=true
                shift
                ;;
            -c|--compile)
                compile_only=true
                shift
                ;;
            -v|--verbose)
                verbose=true
                shift
                ;;
            --fix)
                fix_mode=true
                shift
                ;;
            -*)
                log_error "Unknown option: $1"
                show_help
                exit 1
                ;;
            *)
                files+=("$1")
                shift
                ;;
        esac
    done
    
    # If --all specified, find all files
    if [[ "$check_all" == "true" ]]; then
        mapfile -t files < <(find_lisp_files)
    fi
    
    # If no files specified, use default patterns
    if [[ ${#files[@]} -eq 0 ]]; then
        mapfile -t files < <(find_lisp_files)
    fi
    
    if [[ ${#files[@]} -eq 0 ]]; then
        log_error "No Lisp files found to check"
        exit 1
    fi
    
    log_info "Checking ${#files[@]} file(s)..."
    echo ""
    
    # Run checks
    for file in "${files[@]}"; do
        # Make path absolute if relative
        if [[ ! "$file" = /* ]]; then
            file="$PROJECT_ROOT/$file"
        fi
        
        if [[ "$syntax_only" == "true" ]]; then
            check_syntax "$file" "$verbose"
        elif [[ "$compile_only" == "true" ]]; then
            compile_check "$file" "$verbose"
        else
            # Full check
            check_syntax "$file" "$verbose" && compile_check "$file" "$verbose"
        fi
    done
    
    # Summary
    echo ""
    echo "========================================"
    echo "SUMMARY"
    echo "========================================"
    echo -e "Checks passed: ${GREEN}$CHECKS_PASSED${NC}"
    echo -e "Checks failed: ${RED}$CHECKS_FAILED${NC}"
    echo -e "Warnings: ${YELLOW}$WARNINGS${NC}"
    echo ""
    
    if [[ $CHECKS_FAILED -gt 0 ]]; then
        echo -e "${RED}❌ Lint failed${NC} - fix issues before committing"
        exit 1
    else
        echo -e "${GREEN}✅ All checks passed${NC}"
        exit 0
    fi
}

main "$@"
